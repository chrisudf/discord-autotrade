# discord-autotrade 环境变量模板
# 复制为 config/.env 后填写；app 启动时由 autotrade.app.main 加载一次
# （load_dotenv override=True），库代码不在 import 时读 .env。
# 注释里的「缺省」= 变量不设时代码使用的 fallback 值。

# ============ Discord（autotrade.app.preflight / app.main） ============
# Discord
DISCORD_USER_TOKEN=your_user_token_here
# 下面两个是单频道时代的历史遗留，现行代码**不再读取**——
# 频道 / 触发用户一律配置在 config/channels.json（见 channels.json.example）
DISCORD_CHANNEL_ID=123456789
DISCORD_TRIGGER_USER_IDS=987654321,111222333

# ============ 运行模式（autotrade.broker / app.preflight，运行时每次重读） ============
# true = 不真下单（缺省，安全起见）；false = 真单（盘别由 MOOMOO_TRD_ENV 决定）
DRY_RUN=true

# ============ moomoo OpenD（autotrade.broker.common，import 时读取） ============
# moomoo OpenD
MOOMOO_HOST=127.0.0.1
MOOMOO_PORT=11111
# SIMULATE / REAL（代码会 strip().upper()，防 "simulate" / " REAL " 写法失效）
MOOMOO_TRD_ENV=SIMULATE
MOOMOO_TRD_PWD=your_trade_password
# 旧名 MOOMOO_TRADE_PWD 仍兼容（命中会 warn 提示迁移到 MOOMOO_TRD_PWD）
# MOOMOO_TRADE_PWD=
# DRY_RUN=false 时必填且非零——空着启动会在接到信号时才暴露（6/18 IWM 卖单失败教训），
# preflight 会强制 exit
MOOMOO_ACC_ID=0
# snapshot.update_time 的时区。moomoo 返回**无时区的美东时间**字符串，
# 缺省 America/New_York；若实测 OpenD 返回其它时区再覆盖（缺省即可）
# MOOMOO_QUOTE_TZ=America/New_York

# ============ Telegram（autotrade.notify.transport，import 时读取） ============
# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ============ Trading（autotrade.broker.common） ============
# Trading
# 频道未配置 default_qty 时的兜底张数（缺省 1）
DEFAULT_QTY=1
MAX_SLIPPAGE_PCT=5  # DEPRECATED 2026-06-18: broker 改为分档（12/8/5%），见 moomoo_client._get_slippage_pct（现 autotrade/policy/pricing.py）

# ============ 风控（autotrade.risk） ============
# Layer 1: 单张合约价格上限（美元/张；缺省 5.0——老 .env.example 示例值 2.0）
MAX_PRICE_PER_CONTRACT=2.0
# Layer 3: 当日累计成本上限（触发后当日全停；缺省 2000）
MAX_DAILY_COST=2000
# Layer 4: 当日下单次数上限（触发后当日全停；缺省 10）
MAX_DAILY_ORDERS=10
# Layer 2: 单笔订单成本上限。REAL 无论怎么设都强制 ≤ $1000（只能调低）；
# SIMULATE / DRY_RUN 缺省 100000（模拟盘不限）。每次 check_order 重读。
# MAX_COST_PER_ORDER=1000

# ============ SL 止损 watcher（autotrade.position.sl_watcher，每次 tick 重读） ============
# 亏损比例阈值（缺省 0.50 = -50% 触发止损卖出）
STOP_LOSS_PCT=0.50
# 轮询间隔秒（缺省 5）
SL_POLL_INTERVAL=5
# 止损卖单向下滑点（缺省 0.08 = 8%）
SL_SELL_SLIP=0.08

# ============ TP 分批止盈 watcher（autotrade.position.tp_watcher） ============
# 轮询间隔秒（缺省 5）
TP_POLL_INTERVAL=5
# 止盈卖单向下滑点（缺省 0.05 = 5%）
TP_SELL_SLIP=0.05

# ============ 卖出拒单熔断（autotrade.position.retry_guard，四路共用） ============
# [8/13 postmortem] MU 945C 的 TP T1 打在 broker 的 naked-short 防护上
# （broker 0 长仓 / 本地 DB 说 2 张），拒单不留痕迹 → 每 5s 重来一次，
# 00:11 刷到 06:00：1918 次拒单、5754 行日志、终端日志 1.09MB（前一晚 363 行）。
# 现在：瞬时拒单指数退避，连续 N 次后熔断；naked-short 这类**确定性拒单
# 一次就熔断**（重试到天亮也是同一个答案）。熔断不置 tp_hits 位，重启即恢复。
# SL/TP 走完整退避+熔断；EOD/kc_close 只吃熔断那一半（它们自己的重试节奏
# 是设计好的：EOD 有 60s skip_until，kc_close 靠双语孪生天然重试一次）。
SELL_REJECT_MAX_FAILS=5
# 退避起步秒数，之后翻倍（30 → 60 → 120 → 240 …）
SELL_REJECT_BACKOFF_BASE_SEC=30
# 退避封顶秒数
SELL_REJECT_BACKOFF_CAP_SEC=300

# ── 重复日志收敛（autotrade.utils.logdedup） ──────────────────────────
# 熔断之外的第二层：同一句日志在窗口内只落一条，被压掉的条数补在下一条行尾。
# 设 0 = 不收敛（排查时临时打开）。
LOG_DEDUP_WINDOW_SEC=60

# ============ EOD 到期强平 watcher（autotrade.position.eod_watcher） ============
# 美东 EOD_HOUR:EOD_MIN 起开始检查当日到期仓位（缺省 15:50 ET）
EOD_HOUR=15
EOD_MIN=50
# 检查间隔秒（缺省 30）
EOD_CHECK_INTERVAL=30
# 强平卖单向下滑点（缺省 0.10 = 10%）
EOD_SELL_SLIP=0.10

# ============ 成交确认（autotrade.position.fill_checker） ============
# 订单状态轮询间隔秒（缺省 15）
FILL_POLL_SEC=15
# 超时秒：超过仍未成交则告警（缺省 180）
FILL_TIMEOUT_SEC=180

# ============ 路径（autotrade.settings，重构新增） ============
# 日志 / 数据目录，缺省 = 仓库根下 logs/ 与 data/。
# 注意：本期 storage 各模块的 DB_PATH 仍是模块内常量，不消费 DATA_DIR；
# DATA_DIR 仅供 app 层（Settings）使用。
# LOG_DIR=/path/to/logs
# DATA_DIR=/path/to/data

# ============ 测试 / 诊断（仅 DRY_RUN 路径读取） ============
# DRY_RUN 时 mock 报价：全局固定价，或按合约码单独指定
# （autotrade.broker.quote：MOCK_LAST_PRICE_<option_code> 优先于 MOCK_LAST_PRICE）
# MOCK_LAST_PRICE=1.23
# MOCK_LAST_PRICE_US.TSLA260117C300000=2.50
# ops.backtest_parser 拉取历史消息条数上限（缺省 1000）
# BACKTEST_HISTORY_LIMIT=1000

# ---- 回补与信号年龄(7/28) ----
# 启动回补:启动时重放最近 N 分钟的频道历史(0=关闭)。晚启动/重启不再丢信号;
# 陈旧 OPEN 只告警不下单(见 OPEN_SIGNAL_MAX_AGE_SEC),CLOSE 照常执行。
# 重放的跨进程幂等靠 raw_signals 水位线:上次运行已处理过的 msg_id 不再重放
# (否则重启会把上次已执行的 trim 再执行一遍)。
STARTUP_BACKFILL_MIN=60
# OPEN 信号最大年龄(秒):回补重放的开仓信号超过此年龄 → 降级为 TG 告警。
# 实时信号(几百 ms)不受影响。
OPEN_SIGNAL_MAX_AGE_SEC=300
# 每频道每次回补最多拉多少条历史(缺省 200)。窗口内消息超过它会告警,
# 且丢弃的是**最老**的几条(实现按"新→旧拉取再倒序重放")。
# 60 分钟启动回补 + 活跃频道时可调大。必须 >= 1。
BACKFILL_HISTORY_LIMIT=200

# ---- 降噪节流 ----
# 同一仓位的 runner-preserve TG 提醒窗口(秒,缺省 3600):窗口内只发一次,
# 其余只 log——单张仓遇上连环 trim 时一夜能刷 6 条相同提醒。0=不节流。
RUNNER_PRESERVE_ALERT_WINDOW_SEC=3600

# 注:以上数值型旋钮写坏了(非数字 / 越界)不会让程序崩——解析失败会告警一次
# 并按上面标注的缺省值继续跑(autotrade.utils.envcfg)。改完记得看启动日志有没有
# [envcfg] 告警,否则你以为改生效了其实跑的是默认值。

# ═══ 0010-0018 批次新增旋钮(数值型均走 envcfg 容错，写坏告警退默认) ═══
# ---- lotto -80% 硬底(0013) ----
# category=lotto / 0dte_lotto 仓位的"残值回收"硬底:亏损达到该百分比即全平,
# 走与全局 SL 完全同一条卖出/冻结代码。放飞哲学不变:lotto 照旧不挂 TP、
# 不吃全局 SL;这只是在接近归零时抢回最后一点权利金。
# 案例:AVGO 415C(7/23-24 夜)单张 lotto 从 +50% 一路拿到过期归零。
# 单位是**整数百分比**(80 = -80%),与 STOP_LOSS_PCT 的小数写法不同,勿混;
# 设 0 = 关闭(lotto 仓位完全不进 SL 选仓,不占 snapshot 配额)。
# 注意:变量不设时代码缺省 0(关,[ship-dark] 保持旧的"lotto 放飞"语义);
# 本模板给 80 = 生产部署即启用契约意图的硬底。
LOTTO_STOP_LOSS_PCT=80

# ---- CLOSE 无价实时报价 fallback [0010](autotrade.listener.close_flow,每次重读) ----
# KC 喊 trim/close 但没喊价时(7/25 夜 "Trimmed AVGO +20%" 实锤全漏),
# 是否用实时报价做卖出参照:bid 优先(卖单要吃穿 bid),否则 last,
# 限价 = 参照 × (1 - SELL_SLIP)。报价复用 watcher 的 snapshot 机制
# (60s 新鲜度门 + 限频/无权限退避共享,见 broker.quote.get_sell_ref_price)。
# true(缺省) = 拿到新鲜报价才卖;拿不到仍拒卖 + TG 人工接管(底线不变)。
# false = 与 0010 之前完全一致:信号无价一律拒卖。
# 生产机验证:python -m autotrade.diag.diag_sell_ref <option_code>
CLOSE_QUOTE_FALLBACK=true

# ---- 策略B:runner 达标即全出 [0011](autotrade.listener.close_flow,每次重读) ----
# runner-preserve(策略A,单张仓 + trim<100% 一律死拿)的升级:KC 喊 trim 被
# 拦下时,取实时报价(与 0010 同一 helper:bid 优先/60s 新鲜度门/共享配额退避)
# 算**我方**浮盈,达标(>= STRATEGY_B_MIN_PNL_PCT)→ 该仓位全部剩余卖出——
# 单张仓不存在"卖 33%"的最小单位,全出是唯一可行响应;未达标或拿不到新鲜
# 报价 → 维持策略A死拿(TG 附原因)。KC 自报的 ±N% 只进文案不进判断
# (他的进场价和我们隔着 slippage+时间差,口径对齐留 SIMULATE 实测后调)。
# 动机:AVGO 415c(7/23-24 夜)+50% 一路死拿到过期归零。
# false(缺省 [ship-dark])= 行为与策略A逐字一致,架构先走通,实测后再开。
#
# **[2026-08-29] 本模板改为 true —— 实测后开。** 8/28 夜的教科书场景:
# AAPL 330c 只剩 1 张、入场 5.05,KC 连喊四次 trim(报到 6.85 / 7.50,
# 我方 +36% / +48%),**四次全被 runner-preserve 死拿住,一张没落袋**。
# 而它只剩 1 张是 8/28 那条 UNG 战报误卖造成的 —— 策略A 的"单张仓一律死拿"
# 在这种**被动变单张**的仓位上等于完全放弃止盈。
# 代码缺省仍是 false(不改代码默认值:没配 .env 的环境行为不变)。
STRATEGY_B=true
# 我方浮盈达标阈值(整数百分比,25 = +25%;缺省 25)
STRATEGY_B_MIN_PNL_PCT=25

# ---- 定时对账 reconciler [0016](autotrade.position.reconciler,report-only) ----
# broker 持仓 vs 本地 DB open 仓位定时 diff:发现漂移只发 TG,**绝不写 DB**。
# 三类:DB有/broker无(疑似已行权或场外平仓)、broker有/DB无(幽灵仓,
# SL/TP/EOD 不保护)、张数不一致(部分场外平仓/记账失败)。
# 背景:OCC ITM 自动行权无感知(lessons #14/#15,7/2 实锤);7/25 夜 AVGO 415C
# 强平失败过期后本地仍挂 OPEN,夜里零可见性——之前只有人工跑
# ops/sync_positions 才能发现。
# 单位**分钟**;变量不设时代码缺省 0 = 关(不起后台 task,行为与 0016 之前
# 逐字一致)。本模板给 60 = 生产部署即每小时对一轮(启动时先跑一次)。
# DRY_RUN=true 时每轮直接跳过——mock 成交只进本地 DB,对账必然满屏假漂移。
# 同一份漂移不重复轰炸:内容不变时 TG 只发一次(log 每轮照记),漂移变化才重发。
RECONCILE_INTERVAL_MIN=60

# [0018,8/13] db_only(broker 明确说没有这张仓)自动落账为 CLOSED。
# 触发它的是 8/13 夜:00:27 对账**看见了** MU 945C 的 db_only 并报了 TG,
# 然后按签名节流沉默,那条陈旧 OPEN 挂到 06:00 —— TP 对着空仓打了 1918 次。
# 1 = 开(缺省),0 = 退回 0016 的 report-only。
# qty 不一致与幽灵仓仍然只报告,不自动改(会改变 SL/TP 卖出张数 / 要猜入场价)。
RECONCILE_AUTO_CLOSE=1
# 单轮最多自动落账几条(缺省 3)。超过就退回只报告——一次消失这么多仓,
# 更像 position_list_query 出了问题,不像真的。
# 另有一道硬闸门写死在代码里:broker 侧期权持仓为 0 时**一律不落账**
# (分不清"真全平"和"查询返回空 df",后者会把全部活仓一次清空)。
RECONCILE_AUTO_CLOSE_MAX=3

# ── watcher tick 异常告警节流 ──────────────────────────────────────────
# [7/31 postmortem,lessons #19] 磁盘写满那晚 sl/tp/eod 三路在 22 秒里连抛
# 33 条 disk I/O error,TG 全程沉默——因为 watcher 的 except 分支当时只有
# logger.exception(),而**日志本身就是写不进去的那个东西**(app log 08:34
# 直接跳到 11:10、errors/ 当天 0 字节)。风控三路全灭,磁盘上零痕迹。
# 现在改走 notify/watchdog:首次出错立刻发,之后每个 scope 冷却本秒数,
# 冷却期内的次数攒着下次一并报出;恢复时补一条 ✅ 带被压掉的次数。
# 单位**秒**;设 0 = 不节流(每次出错都发,仅调试用——22 秒 33 条 TG 刷屏
# 等于没有告警,见 lessons #12 与 7/23 runner-preserve 一夜 6 连发)。
WATCHER_ERROR_ALERT_COOLDOWN_SEC=300

# ── 无 TP 阶梯仓位的高盈利提醒（autotrade.position.tp_watcher） ──────────
# [8/28 $ALAB] lotto / 0dte 按设计不挂 TP 阶梯（"放飞"），也没有 SL。
# 那晚 ALAB 300C 涨到 +400%，喊单员发了 "Scale out." 但 parser 接不住
# （祈使式不在动词表，已修），于是**一张没卖**，仓位一路带到到期日 ——
# "放飞" 的实际含义变成了"唯一出场路径是一条可能解析不出来的消息"。
# 现在这类仓位涨到本档就发 TG（只提醒不卖），之后每翻一倍再提醒一次。
# 单位百分比；0 = 关。
NO_LADDER_ALERT_PCT=200
